{
    "layer": "top",
    "position": "bottom",
    "modules-right": [ 
        "custom/kernel",
        "custom/seperator",
        "cpu",
        "custom/seperator",
        "memory",
        "custom/seperator",
        "disk",
        "custom/seperator",
        "clock"

    ],
    "modules-center": [ ],
    "modules-left": [
        "group/worksp",
        "custom/seperator",
        "custom/shutdown",
        "custom/notifications",
        "pulseaudio",
        "bluetooth"
    ],
    "group/worksp":{
        "orientation": "horizontal",
        "modules":["hyprland/workspaces"]
    },
    "hyprland/window": {
        "max-length": 50
    },
    "clock": {
        "format": " {:%d %b %H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
              
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
            "6": [],
            "7": [],
            "8": [],
            "9": []
        }
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-connected": "",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "exec blueman-manager"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["",""]
        },
        "scroll-step": 1,
        "ignored-sinks": ["Easy Effects Sink"],
        "on-click": "pavucontrol"
    },
    "custom/notifications": {
        "format": "",
        "on-click": "exec swaync-client -t"
    },  
    "custom/shutdown": {
        "format": "",
        "on-click": "~/nixconfig/home/1080dots/rofi/shutdown.sh"
    }, 

    "custom/seperator": {
        "format": "|"
    },
    "cpu": {
        "interval": 10,
        "format": " {avg_frequency}GHz {usage}%"
    },
    "memory": {
        "interval": 30,
        "format": " {used:0.1f}G / {total:0.1f}G"
    },
    "disk": {
        "format": "󰗮 {percentage_used}% used"
    },
    "custom/kernel": {
        "exec": "~/nixconfig/home/1080dots/waybar/kernel.sh",
        "interval": 60,
        "format": " kernel: {}",
        "tooltip-format": " linux kernel: {}",
        "on-click": ""
    }
}
