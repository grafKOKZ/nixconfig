configuration {
  display-drun: "Applications:";
  display-window: "Windows:";
  drun-display-format: "{icon} {name}";
  font: "JetbrainsMono Nerd Font Medium 10";
  modi: "window,run,drun";
  show-icons: true;
  icon-theme: "Papirus";
}

@theme "/dev/null"

* {
  bg3: #1e1e2e;
  bg2: #11111b;
  bg: #181825;
  bg-alt: #ca9ee6;

  fg: #eff1f5;
  fg-alt: #7c7f93;

  background-color: @bg;

  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 35%;
  padding: 18;
  background-color: @bg2;
}

element {
  padding: 12;
  text-color: @fg-alt;
  margin: 10;
}

element selected {
  text-color: @fg;
  margin: 10;
  background-color: @bg3;
}

element-text {
  background-color: inherit;
  text-color: inherit;
  vertical-align: 0.5;
}

element-icon {
  size: 30;
}

element-icon selected {
  size: 30;
  background-color: @bg3;
}

entry {
  padding: 12;
  text-color: black;
  background-color: @bg-alt;
}

inputbar {
  children: [prompt, entry];
  margin: 0 0 18 0;
}

listview {
  columns: 2;
  lines: 7;
}

mainbox {
  children: [inputbar, listview];
  background-color: @bg2;
}

prompt {
  enabled: true;
  padding: 12 0 0 12;
  background-color: @bg-alt;
  text-color: black;
}
