// Inspired by Catnap
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "position": "left",
    "color": { "1":"#ffffff", "2":"#ffffff", "3": "#ffffff", "4": "#ffffff", "5": "#ffffff", "6": "#ffffff" },
    "source": "nixos", // Path to your logo file
    "type": "small", // 'auto' detects the best protocol for your terminal
    "width": 12, // Adjust width (in characters)
    "padding": {
      "top": 3,
      "right": 3,
      "left": 0,
    },
  },
  "display": {
    "separator": "-> ",
    "color": {
      "output": "#ffffff",
      "keys": "#BA68C8",
      "separator": "#727272",
    },
  },
  "modules": [
    /*{
      "format": "           System Infomation           ",
      "type": "custom",
      "keyColor": "#5b9bf8",
    },*/
    /*{
      "format": "{##727272}#----------{#}{##AB47BC}System Infomation{#}{##727272}---------#{#}",
      "type": "custom",
    },*/
    {
      "format": "{##727272}#-------------------------------------#{#}",
      "type": "custom",
    },
    {
      "key": "   user   ",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "  󰇅 hname  ",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "type": "command",
      "key": "  󱦟 os age ",
      "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c     %W /)) / 86400 ))\"",
    },
    "break",
    {
      "key": "  󰅐 uptime ",
      "type": "uptime",
    },
    {
      "key": "  {icon} distro ",
      "type": "os",
    },
    {
      "key": "   kernel ",
      "type": "kernel",
    },
    "break",
    {
      "key": "  󰇄  wm    ",
      "type": "wm",
    },
    {
      "key": "   shell  ",
      "type": "shell",
    },
    {
      "key": "  󰍛 cpu    ",
      "type": "cpu",
      "format": "{name} ({cores-logical})",
    },
    {
      "format": "{##727272}#-------------------------------------#{#}",
      "type": "custom",
    },
    "break",
  ],
}
