set number
set encoding=utf-8
set laststatus=2 
set hlsearch
set relativenumber
set nocompatible
colorscheme catppuccin
filetype plugin indent on 
set expandtab 
set shiftwidth=2
set smartindent

set backspace=indent,eol,start

syntax on

let mapleader = " "

nnoremap <leader>cd :Ex %:p:h<CR>
inoremap jk <Esc>
